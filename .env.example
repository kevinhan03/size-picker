GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Server-only Fashion Agent model (Responses API / structured outputs)
OPENAI_FASHION_AGENT_MODEL=gpt-4.1-mini
PORT=8787
SUPABASE_URL=https://csbvhoczfmdlelmfjqij.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_PRODUCTS_TABLE=products
SUPABASE_STORAGE_BUCKET=product-assets
SUPABASE_BUCKET_PUBLIC=true
# Optional private image-embedding worker (Marqo/marqo-fashionSigLIP, 768 dimensions)
IMAGE_EMBEDDING_WORKER_URL=http://127.0.0.1:8001
IMAGE_EMBEDDING_WORKER_SECRET=replace_with_a_long_random_secret
IMAGE_EMBEDDING_WORKER_TIMEOUT_MS=60000
# Optional public Render Playwright fallback for dynamic size charts.
# Set the same 32+-character secret in Vercel and Render; never use NEXT_PUBLIC_.
SIZE_EXTRACTION_SECRET=replace_with_a_long_random_size_extraction_secret
SIZE_SCRAPER_URL=https://your-render-scraper.onrender.com
SIZE_EXTRACTION_CALLBACK_URL=https://your-domain.vercel.app/api/size-extractions/callback
SIZE_EXTRACTION_GEMINI_MODEL=gemini-2.5-flash
ADMIN_PASSWORD=change_this_admin_password
ADMIN_SESSION_SECRET=change_this_to_a_long_random_secret
ADMIN_SESSION_TTL_SECONDS=28800
CRON_SECRET=replace_with_a_long_random_cron_secret
# Server-only diagnostics; never changes production recommendation ranking.
FASHION_AGENT_CLUSTER_SHADOW=false
# Internal-only experiments. Keep off in normal environments.
FASHION_AGENT_EXPERIMENTS=false
FASHION_AGENT_QUERY_TASTE_OBSERVATION=false
NEXT_PUBLIC_SUPABASE_URL=https://csbvhoczfmdlelmfjqij.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only PostHog ingestion and session replay proxy. Never expose this value to the browser.
POSTHOG_API_KEY=your_posthog_project_api_key
ANALYTICS_USER_HASH_SECRET=replace_with_a_long_random_secret
